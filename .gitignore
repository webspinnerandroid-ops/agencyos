# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# Baked by the deploy script before upload; never commit.
public/version.txt

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit (may contain real secrets)
.env*

# local tooling / scratch (any .dot-tmp artifact, repo root or nested)
.freebuff/
.tmp-*
scripts/*.log
scripts/*.err
run-capture.ps1
capture.log
capture.err

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI cache (project refs, local state)
/supabase/.temp/

# ---------------------------------------------------------------------------
# Deployment & diagnostics artifacts (repo-root level only)
# Ad-hoc deploy/diag/fix/verify scripts and their output logs. These encode
# the VPS deploy pattern but also contain live credentials — keep them local
# and git-ignored. Real tooling lives in /scripts and /src.
# ---------------------------------------------------------------------------
/*.cjs
/*.js
/*.cmd
/*.bat
/*.sh
/*.txt
/*.log
/*.err
*.bak*

# ---------------------------------------------------------------------------
# Archived one-off tooling and run logs (hygiene pass, 2026-10-23).
# The deploy/diag/verify scripts from the Aug 2026 VPS rounds now live in
# scripts/legacy/, and their output logs in docs/archive/run-logs/. They encode
# a deploy pattern the project no longer uses and several contain live
# credentials, so both stay local and ignored. Real tooling lives in /scripts.
# See docs/HYGIENE-2026-10-23.md.
# ---------------------------------------------------------------------------
/scripts/legacy/
/docs/archive/
scripts/*.pid

# screenshot capture session cookies (contains the logged-in dev session)
scripts/.session-cookies.json
.edge-profile-*/

# esbuild bundles of the one-off .ts scripts in /scripts — rebuildable, and
# this wildcard also bloats nothing new: it keeps them (and NEW hand-written
# .cjs scratch scripts) ignored by default. Files that are already tracked
# stay tracked — gitignore rules never apply to tracked paths — so the repo's
# one-off .cjs tools (audit-*.cjs, backfill-*.cjs, the _*-diagnostic scripts,
# check-price-drift.cjs …) keep their history no matter what this wildcard
# says. No allowlist to maintain. When a new script IS meant to be tracked,
# add it once with:
#   git add -f scripts/<name>.cjs
scripts/*.cjs
.bliss/
# Private pasted credentials — local only
.secrets/
# Playwright run artifacts (error contexts, screenshots, auth storage states)
test-results/
playwright-report/
# Supabase in-flight manual SQL — scratch until it becomes a numbered
# migration in supabase/migrations/. Kept on disk, never committed.
/supabase/pending-manual*.sql

# QA-AUDIT kill-safe sweep journal {pid -> fixture tenant}
.qa-audit-runs.json
