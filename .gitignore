# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# Baked by the deploy script before upload; never commit.
public/version.txt

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit (may contain real secrets)
.env*

# local tooling / scratch
.freebuff/
scripts/.tmp-*
scripts/*.log
scripts/*.err
run-capture.ps1
capture.log
capture.err

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI cache (project refs, local state)
/supabase/.temp/

# ---------------------------------------------------------------------------
# Deployment & diagnostics artifacts (repo-root level only)
# Ad-hoc deploy/diag/fix/verify scripts and their output logs. These encode
# the VPS deploy pattern but also contain live credentials — keep them local
# and git-ignored. Real tooling lives in /scripts and /src.
# ---------------------------------------------------------------------------
/*.cjs
/*.js
/*.cmd
/*.bat
/*.txt
/*.log
*.bak*

# screenshot capture session cookies (contains the logged-in dev session)
scripts/.session-cookies.json
.edge-profile-*/

# esbuild bundles of the one-off .ts scripts in /scripts — rebuildable, and
# they bloat the repo (multi-MB each). Keep only the TypeScript source.
scripts/*.cjs

# Hand-written operational scripts (no .ts source) — keep tracked.
!scripts/audit-tenant-scope.cjs
!scripts/manual-traffic-sync.cjs
!scripts/sanitize-seo-campaigns.cjs
!scripts/sync-site-domains.cjs
!scripts/backfill-assets.cjs
!scripts/backfill-post-scores.cjs
!scripts/delete-broken-assets.cjs
# Committed bundle for the nightly price-drift check (built from .ts via
# esbuild; kept tracked so the CI job runs it without a build step).
!scripts/check-price-drift.cjs
