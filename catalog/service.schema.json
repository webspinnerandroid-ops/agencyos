{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bliss Media Lab service catalog entry",
  "type": "object",
  "required": ["service", "required_fields", "workflow", "documents"],
  "additionalProperties": false,
  "properties": {
    "service": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "description": { "type": "string" },
    "required_fields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z_]+$" }
    },
    "repo_template": { "type": ["string", "null"] },
    "provision_subsystems": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "agency_os_workspace",
          "agency_os_seo",
          "agency_os_cms",
          "freecms_repo",
          "stripe",
          "docusign"
        ]
      }
    },
    "workflow": { "type": "string", "enum": ["onboard_client"] },
    "documents": {
      "type": "array",
      "items": { "type": "string", "enum": ["service_agreement", "invoice", "proposal"] }
    },
    "pricing_defaults": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    }
  }
}
